# Required for the default model configuration.
DEEPSEEK_API_KEY=

# Optional compatibility key if you switch model code to OpenAI-compatible providers.
OPENAI_API_KEY=

# Optional, reserved by the current settings module.
BAIDU_API_KEY=

# Optional runtime switches.
MODEL_NAME=deepseek-v4-flash
EVALUATOR_MODEL_NAME=deepseek-v4-flash
ENABLE_STREAMING=true
ENABLE_PLAN_PROPOSAL=true
RAG_ENABLED=true
RAG_TOP_K=3
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
